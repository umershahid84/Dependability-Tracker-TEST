{
  "name": "dependability-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"ts-node ./src/scripts/removeExpired.ts\" \"next dev\"",
    "build": "next build",
    "start": "concurrently \"ts-node ./src/scripts/removeExpired.ts\" \"next start\"",
    "lint": "next lint",
    "seed": "ts-node ./src/db/seeds/index.ts",
    "ts": "node --loader ts-node/esm --env-file=./.env -r ts-node/register",
    "test": "jest --detectOpenHandles"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.5",
    "mysql2": "^3.10.2",
    "next": "14.2.4",
    "nodemailer": "^6.9.14",
    "react": "^18",
    "react-dom": "^18",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^6.4.15",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.4",
    "jest": "^29.7.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
