{
  "name": "dependability-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint": "next lint",
    "ts": "node -r ts-node/register",
    "update-packages": "npm-check -u",
    "build": "node ./scripts/build.mjs",
    "clean": "node ./scripts/clean.mjs",
    "update": "node ./scripts/update.mjs",
    "removeTel": "npx next telemetry disable",
    "seed": "ts-node ./src/scripts/seedDb.ts",
    "uninstall": "node ./scripts/uninstall.mjs",
    "createEnv": "npm run ts -- ./src/scripts/createEnv.ts",
    "install-service": "node ./scripts/install-as-service.mjs",
    "genTLS": "npm run ts -- ./src/scripts/generateTLSCerts.ts",
    "sendInvite": "npm run ts -- ./src/scripts/loginCredInvite.ts",
    "seed-callout": "ts-node ./src/lib/db/seeds/callouts.ts",
    "seed-callouts-365": "ts-node ./src/lib/db/seeds/callouts.ts 365",
    "test": "node --env-file='.env.test' ./node_modules/.bin/jest --runInBand --detectOpenHandles",
    "start": "concurrently \"npm run ts ./src/scripts/removeExpired.ts\" \"cross-env NODE_ENV=production node ./dist/server/index.js\"",
    "dev": "concurrently \"npm run ts ./src/scripts/removeExpired.ts\" \" cross-env PORT=3000 nodemon --watch src --ext ts --exec ts-node ./src/server/index.ts\""
  },
  "nodemonConfig": {
    "ignore": [
      "**/*.spec/**"
    ]
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.3.2",
    "bcrypt": "^6.0.0",
    "chart.js": "^4.5.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mariadb": "^3.4.5",
    "mysql2": "^3.16.1",
    "next": "^16.1.6",
    "nodemailer": "^7.0.12",
    "react": "^19",
    "react-dom": "^19",
    "react-test-renderer": "^19.2.3",
    "sequelize": "^6.37.7",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.9",
    "@types/nodemailer": "^7.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-test-renderer": "^19.1.0",
    "autoprefixer": "^10.4.23",
    "eslint": "^9",
    "eslint-config-next": "16.1.3",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
