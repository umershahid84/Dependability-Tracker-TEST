# Example Environment Configuration for Apache Reverse Proxy Setup
# Copy this to .env and customize with your actual values
#
# This configuration is optimized for deployment behind Apache on port 443

# ============================================================================
# Node.js Server Configuration
# ============================================================================

# Port for Node.js server (Apache will proxy to this)
# Keep on localhost with a non-privileged port since Apache handles external access
PORT=3000

# Alternative ports if 3000 is in use:
# PORT=8080
# PORT=3001

# ============================================================================
# Database Configuration
# ============================================================================

DB_HOST=localhost
DB_PORT=3306
DB_NAME=dependability_tracker
DB_DIALECT=mysql
DB_USER=<your_database_username>
DB_PASS=<your_database_password>

# ============================================================================
# Email Configuration (SMTP)
# ============================================================================

SEND_EMAILS=true
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_HOST=<your_smtp_host>
EMAIL_USER=<your_email_username>
EMAIL_SENDER=<noreply@yourdomain.com>
TEST_EMAIL_USER=<test_recipient@yourdomain.com>

# Common SMTP Hosts:
# - Gmail: smtp.gmail.com (port 587 or 465)
# - Outlook: smtp-mail.outlook.com (port 587)
# - Office 365: smtp.office365.com (port 587)
# - Custom: your-smtp-server.com

# ============================================================================
# JWT Configuration (Authentication)
# ============================================================================

# These will be auto-generated if left as placeholders
# Or provide your own secure random strings
JWT_SECRET=<32-character-secret>
JWT_EXPIRES_IN=10h
JWT_ALGORITHM=HS256

# ============================================================================
# Encryption Configuration
# ============================================================================

# These will be auto-generated if left as placeholders
# Or provide your own secure random strings
AES_SALT=<32-byte-salt>
AES_PEPPER=<32-byte-pepper>

# ============================================================================
# Node Environment
# ============================================================================

# Set to 'production' when running behind Apache in production
NODE_ENV=production

# ============================================================================
# Notes for Apache Reverse Proxy Setup
# ============================================================================
#
# 1. The Node.js server will run on localhost:PORT (default 3000)
# 2. Apache listens on port 443 (HTTPS) and forwards to Node.js
# 3. No need to set TLS certificates in Node.js - Apache handles SSL/TLS
# 4. Firewall should allow port 443 (HTTPS), not port 3000
# 5. Ensure Node.js is running before starting/restarting Apache
#
# Generate this file with default values:
# npm run createEnv -- false 465 root dbPassword email@domain.com smtp.host.com noreply@domain.com test@domain.com
#
# Or create manually and replace values within <>
# ============================================================================
